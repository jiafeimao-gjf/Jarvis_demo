# ===========================================
# JARVIS 贾维斯智能助手 - 环境配置
# ===========================================
# 格式说明: 使用 __ 分隔嵌套配置
# 例如: AI__default_provider = ollama
# ===========================================

# ============== 应用信息 ==============
APP_NAME=JARVIS
APP_VERSION=0.1.0

# ============== 服务器配置 ==============
SERVER__HOST=0.0.0.0
SERVER__PORT=9529
SERVER__DEBUG=false
SERVER__RELOAD=false

# ============== CORS 配置 ==============
CORS__ALLOW_ORIGINS=["http://localhost:8529","http://127.0.0.1:8529"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]

# ============== Ollama (本地 AI) ==============
AI__OLLAMA__BASE_URL=http://localhost:11434
AI__OLLAMA__MODEL=qwen3:4b
AI__OLLAMA__VISION_MODEL=qwen3.5:9b
AI__OLLAMA__T2I_MODEL=x/z-image-turbo
AI__OLLAMA__TIMEOUT=120.0
AI__OLLAMA__MAX_RETRIES=3

# AI__OLLAMA__STT_MODEL 已废弃 — STT 改走本地 Paraformer (见下方 STT 配置)
# 保留字段仅为向后兼容, 不再实际使用

# ============== OpenAI (云 AI, 可选) ==============
AI__OPENAI__API_KEY=your-openai-api-key-here
AI__OPENAI__BASE_URL=https://api.openai.com/v1
AI__OPENAI__MODEL=gpt-4o-mini
AI__OPENAI__TIMEOUT=60.0

# ============== Anthropic (Claude, 可选) ==============
AI__ANTHROPIC__API_KEY=your-anthropic-api-key-here
AI__ANTHROPIC__BASE_URL=https://api.anthropic.com/v1
AI__ANTHROPIC__MODEL=claude-3-haiku-20240307
AI__ANTHROPIC__TIMEOUT=60.0

# ============== AI 全局配置 ==============
AI__DEFAULT_PROVIDER=ollama
AI__DEFAULT_MODEL=qwen3:4b
AI__ENABLE_FALLBACK=false
AI__FALLBACK_CHAIN=["ollama"]

# ============== STT 语音转文字 ==============
# paraformer (中文优化, 默认) | whisper (fallback, 需 pip install openai-whisper)
# 切换后端无需重启代码, 重启 backend 即生效
STT__BACKEND=paraformer
# Paraformer 长音频切片大小 (秒), 调大可减少切片但增加内存
STT__BATCH_SIZE_S=300

# ============== 硬件配置 ==============
HARDWARE__CAMERA_DEVICE_ID=0
HARDWARE__CAMERA_WIDTH=640
HARDWARE__CAMERA_HEIGHT=480
HARDWARE__CAMERA_FPS=30
HARDWARE__MICROPHONE_SAMPLE_RATE=16000
HARDWARE__AUDIO_CHANNELS=1

# ============== 存储配置 ==============
STORAGE__MEMORY_DIR=./memory
STORAGE__LOGS_DIR=./logs

# ============== 日志配置 ==============
LOG_LEVEL=INFO

# ============== 声音克隆 (F5-TTS) ==============
# 默认开启；启用前需：
#   1. pip install f5-tts soundfile
#   2. 前端 Settings → 声音克隆 → 上传参考音频 (ref_text 已有默认值, 无需手填)
# 不装包 / 没 ref 时自动降级到浏览器 TTS，前端零感知
VOICE_CLONE__ENABLED=true
VOICE_CLONE__MODEL=F5TTS_Base
VOICE_CLONE__DEVICE=auto
VOICE_CLONE__SPEED=1.0
VOICE_CLONE__STREAM_CHUNK_MS=300
VOICE_CLONE__REF_AUDIO=workspace/voice/refs/voice.wav
VOICE_CLONE__REF_TEXT=workspace/voice/refs/voice.txt
VOICE_CLONE__SENTENCE_MIN_CHARS=6
VOICE_CLONE__SENTENCE_MAX_CHARS=25
VOICE_CLONE__UPLOAD_MAX_BYTES=20971520